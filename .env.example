# Copy to .env next to docker-compose.yml and adjust.

# --- Docker Desktop Windows + Redis in WSL2 (recommended) ---
# WSL Redis must listen on 0.0.0.0:6379 (not only 127.0.0.1).
# Windows localhost:6379 is forwarded into WSL; Docker reaches Windows via host.docker.internal.
SOURCE_REDIS_URL=redis://host.docker.internal:6379/0
HISTORY_REDIS_URL=redis://host.docker.internal:6379/1

# --- Redis on remote LAN (host Python OK, Docker often timeout) ---
# SOURCE_REDIS_URL=redis://10.192.202.210:6379/0
# HISTORY_REDIS_URL=redis://10.192.202.210:6379/1

MONITOR_CHANNEL=voting_monitor_channel_6
